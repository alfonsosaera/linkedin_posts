import os
from datetime import datetime
import json
from dotenv import load_dotenv

from langchain_community.document_loaders import PyPDFLoader
from langchain_openai import ChatOpenAI
from langchain_core.prompts import PromptTemplate
from langchain_core.output_parsers import StrOutputParser

# ==============
# 0. CONFIG
# ==============
load_dotenv()  

# Modelos
llm_extract = ChatOpenAI(
    model="gpt-5.1",
    model_kwargs={"response_format": {"type": "json_object"}},
)
llm_linkedin = ChatOpenAI(model="gpt-5-mini")

PDF_PATH = './pdfs/s41598-025-20812-1.pdf'

# ==============
# 1. CARGAR PDF
# ==============
loader = PyPDFLoader(PDF_PATH)
docs = loader.load()
paper_text = "\n".join(d.page_content for d in docs)

# =============================================
# 2. PRIMER PROMPT: ANÁLISIS DEL PAPER → JSON
# =============================================
extract_prompt_template_str = """
With the full content of the paper do the following tasks.

1.- Extract publication full author list of the scientific publication. Example:
From: 
Article
Open access
Published: 27 March 2025
SIMVI disentangles intrinsic and spatial-induced cellular states in spatial omics data
Mingze Dong, David G. Su, Harriet Kluger, Rong Fan & Yuval Kluger 
Nature Communications volume 16, Article number: 2990 (2025) Cite this article
2388 Accesses
16 Altmetric
Metricsdetails
Abstract
Spatial omics technologies enable analysis
publication full author list is: Mingze Dong, David G. Su, Harriet Kluger, Rong Fan & Yuval Kluger 

2. Extract the publication title and the publication journal.

3.- Create the next sentence filling the field labeled with {{}} with the data from tasks 1 and 2. 
If one or more fields are not clear just leave the labeled field:
discuss the publication “{{publication title}}” published in {{publication journal}} by {{publication full author list of the scientific publication}}

4.- Provide the main points as a bullet point list. 
The number of bullet points in the list is free. 
It will depend on the number of main points found in the scientific paper. 
Do not predefine the number of bullet points to 10. 
Do not use any information that is not in the publication. 
Use the whole study, not only the abstract. 
Do not say, conclude or infer anything that is not said explicitly in the text. 
Avoid inferring anything based on external knowledge. 

Return the list as a numbered list starting in 5.001., followed by 5.002., increasing the second digit but keeping “5.” constant.  
Do not reference the main text with a link.

After the list, show the specific text supporting each item of the list.  
The main points list and the supporting text list must be two different lists.  
First the main points list, then the supporting text list.

5.- If possible, complete also this text, keeping text, icons and emojis:

📚 {{publication journal}} paper: {{publication link}}
💻 Code: {{link to github or similar repository of the tool}}
🔗 Website: {{link to associated web for the tool if it exists}}

Apply the following rules:

- First, identify whether the paper introduces a primary computational/bioinformatics tool, software package, framework, algorithm, pipeline or web server that is presented as a main contribution of THIS study (for example phrases like “we present”, “we introduce”, “we developed”, “here we describe” referring to a new tool).

- If the paper does NOT introduce any new tool or software (it only uses existing tools developed in other studies), then:
  - Leave the field after "Code:" completely empty.
  - Leave the field after "Website:" completely empty.
  - Still provide the publication link for the paper.

- "Publication link":
  - Use the DOI or the official journal page for THIS paper.

- "Code":
  - Use ONLY a URL that clearly corresponds to the source code repository of the PRIMARY tool introduced in THIS paper (for example GitHub, GitLab, Bitbucket or an institutional code repository directly associated with the tool described as the main contribution).
  - Do NOT use dataset accessions (such as "GEO: GSE...", ArrayExpress IDs, SRA IDs, ENA accessions, Zenodo dataset DOIs) as code links.
  - Do NOT use DOIs or publisher links as code links.
  - Do NOT use repositories or URLs that belong to tools that are only cited or used for comparison, preprocessing or benchmarking; they must be directly associated with the main tool of THIS paper.
  - If no explicit code repository URL for the main tool is provided in the text, leave the field after "Code:" empty.

- "Website":
  - Use a URL that clearly corresponds to a project or tool website (for example a webapp, documentation site, or dedicated project homepage) associated with the PRIMARY tool introduced in THIS paper.
  - This URL SHOULD NOT be the same as the publication link (DOI or journal page), unless the paper explicitly states that the tool itself is only available through that page.
  - Do NOT use websites for other tools that are only cited or used in the study.
  - If no such project/tool website for the main tool exists in the text, leave the field after "Website:" empty.

Always copy the URLs exactly as they appear in the paper/manuscript.
If you are unsure whether a URL belongs to the main tool of this paper, it is safer to leave the corresponding field empty.

6.- Finally explain, with 100% correctness and transparency,  
the type of data you accessed to generate the answer: whole paper, abstract and figures, 
partial parts of the paper via API, etc.  
If the link/paper requires subscription or payment clearly state it.

Now, based on everything you have done in tasks 1 to 6, produce the final answer in the following JSON format:

{{
  "objective_sentence": "A single sentence suitable as an objective/intro for a LinkedIn post. Use the sentence created in task 3 that mentions the publication title, journal, and full author list.",
  "bullet_points": "The full numbered main-points list produced in task 4 (the one starting with 5.001., 5.002., etc.).",
  "supporting_text_list": "The corresponding list of supporting text segments for each bullet point, exactly as produced after the main list.",
  "links_block": "The block of lines produced in task 5, including emojis and plain text URLs exactly as they appear.",
  "data_access_explanation": "The explanation from task 6 about the type of data accessed."
}}

Use ONLY content that appears explicitly in the paper. 
If any of these items cannot be determined, use an empty string "" for that field.

Return ONLY valid JSON, with this exact structure and keys.  
Do not add any explanation or text outside the JSON.

Here is the full text of the paper:
--------------------
{paper_text}
"""

extract_prompt = PromptTemplate.from_template(extract_prompt_template_str)
extract_chain = extract_prompt | llm_extract | StrOutputParser()

json_str = extract_chain.invoke({"paper_text": paper_text})

print("\n===== RAW JSON FROM EXTRACTOR =====\n")
print(json_str)

parsed_data = json.loads(json_str)

objective_sentence = parsed_data.get("objective_sentence", "")
bullet_points = parsed_data.get("bullet_points", "")
links_block = parsed_data.get("links_block", "")
data_access_explanation = parsed_data.get("data_access_explanation", "")

# ==========================================
# 3. SEGUNDO PROMPT: POST DE LINKEDIN
# ==========================================

# modificar prompt para priorizar key point metodologicos sobre biologicos.
linkedin_prompt_template_str = """
Hello ChatGPT,
I am Alfonso Saera Vila. Make sure to clarify the author of the tools I post about and the journal where the tool was published. I would like you to help me write a LinkedIn post. If you include links, do not generate hyperlinks and show the full link as text.

Here are the inputs you must use:
- Objective sentence (intro context):  
{objective_sentence}

- Key points extracted from the paper (long, technical list):  
{bullet_points}

- Link block (publication link, code link, website link):  
{links_block}

Your task is to transform these inputs into a SHORT, HIGH-QUALITY LinkedIn post following these strict rules:

---------------------------- STRUCTURE RULES ----------------------------

1) TITLE  
- The FIRST line must be a title.  
- Do NOT write any label like “Title:”.  
- Include emojis.  
- Must be engaging and professional.  
- Must NOT repeat the exact title of the paper.  
- Prefer formats like:  
  “🎯 <High-level concept>: <Tool name> <emoji>”

2) INTRODUCTION PARAGRAPH  
- Immediately after the title, write ONE single sentence that follows EXACTLY this structure:  
  “The study <title>, published in <journal> by <full author list>, introduces <tool name>, <short high-level description>.”  
- Do NOT use first person (“I discuss”).  
- Do NOT add extra sentences here.  
- The intro MUST explicitly name the tool.

3) MAIN CONTENT (📌 / optional)  
- Select only the 2–4 most relevant points from {bullet_points}.  
- You MAY merge, rewrite, shorten, or omit points.  
- Each selected point must be ONE line starting with “📌 ”.  
- These points must provide value to a LinkedIn bioinformatics/pharma audience.  
- Avoid low-level implementation details (epochs, loss functions, raw counts, excessive statistics).  
- Keep points concise and easy to read.

4) OPTIONAL CONCLUSIONS (✅)  
- Include 0–2 conclusions only if they add meaningful insight.  
- Each must start with “✅ ” and use ONE line.  
- Avoid section headers such as “Conclusions”.

5) OPTIONAL LIMITATIONS / CAVEATS (⚠️)  
- Include 0–1 limitations only if they are clear and important.  
- Start with “⚠️ ”.  
- Must be ONE line.  
- No section header such as “Limitations” or “Caveats”.

6) POST ENDING  
Add this (unchanged), BEFORE the link block:

📢 Join the Conversation 📢  
Share your ideas, methods, and tools in the comments! 👇 💬

👉 Follow my blog for more https://lovednacodeblog.com/

7) LINKS  
- After the ending above, display ONLY the non-empty lines from {links_block}.  
- If “Code:” or “Website:” are empty, omit them entirely.  
- Always show raw URLs (no hyperlinks).  
- Do NOT add section titles or commentary around the links.

---------------------------- STYLE RULES ----------------------------

- The final post must be SHORT and extremely concise.  
- Prioritize clarity and LinkedIn readability.  
- Avoid:  
  • “X excels at Y” → use “X is great at Y” or similar.  
  • “seamless / seamlessly”  
  • “just took a huge leap forward!” → use “made a remarkable advance” or similar.  
- Avoid em dashes (—).  
- Use no bullet characters except 📌/✅/⚠️.  
- Do NOT create section headers of any kind.  
- Do NOT include commentary or meta statements.  
- Keep tone expert, polished, professional.

---------------------------- OUTPUT ----------------------------
Write the final LinkedIn post following ALL rules above.  
Do NOT include any labels, explanations, analysis, or commentary.  
Output ONLY the final post text.
"""

linkedin_prompt = PromptTemplate.from_template(linkedin_prompt_template_str)
linkedin_chain = linkedin_prompt | llm_linkedin | StrOutputParser()

linkedin_post = linkedin_chain.invoke(
    {
        "objective_sentence": objective_sentence,
        "bullet_points": bullet_points,
        "links_block": links_block,
    }
)

# ==========================================
# 4. GUARDAR
# ==========================================
output_dir = "linkedin_outputs"
os.makedirs(output_dir, exist_ok=True)

# Timestamp para evitar sobrescrituras
timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

# Guardar el post de LinkedIn
post_path = os.path.join(output_dir, f"linkedin_post_{timestamp}.txt")
with open(post_path, "w", encoding="utf-8") as f:
    f.write(linkedin_post)

print(f"LinkedIn post guardado en: {post_path}")

# Guardar el JSON del primer prompt
json_path = os.path.join(output_dir, f"paper_analysis_{timestamp}.json")
with open(json_path, "w", encoding="utf-8") as f:
    f.write(json_str)

print(f"JSON del análisis guardado en: {json_path}")
