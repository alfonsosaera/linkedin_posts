# Required
OPENAI_API_KEY=your_openai_api_key_here

# Optional – needed for image uploads to imgbb
IMGBB_API_KEY=your_imgbb_api_key_here

# Optional – needed for direct Buffer API uploads
BUFFER_API_KEY=your_buffer_api_key_here

# Optional – set manually if the Buffer API cannot return your LinkedIn channel ID
# Find it in Buffer dashboard: Settings → Channels → LinkedIn
# BUFFER_CHANNEL_ID=651e550d8af0c048f67ec48c
